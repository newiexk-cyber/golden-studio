# ==============================================================================
# 🛡️ GOLDEN STUDIO - BACKEND API ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# Server Port
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=development

# Google Sheets Configuration (Hidden securely on server-side)
GOOGLE_SHEET_ID=1LRCu0pMw9z8xkAJ9IDv0UsndnoCDQuyEyoRWXRDGdcI
GOOGLE_SHEET_GID=0

# In-memory Cache Duration in Seconds (Default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://goldenstudio-903.pages.dev

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=120
BOOKING_RATE_LIMIT_MAX=10

# Optional Webhook Notifications (Discord or Telegram)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
